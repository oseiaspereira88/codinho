{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codinho.dev/schemas/challenge.schema.json",
  "title": "Challenge",
  "description": "Authoring shape. Go also validates identities, graphs, confined paths and publication semantics; shared corpus covers the intersection (catalog-publication-integrity). Legacy minimal drafts remain loadable by Go.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "kind",
    "difficulty"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "atomic",
        "combined",
        "functional_slice",
        "debugging",
        "refactoring",
        "code_review",
        "systems_mission",
        "simulation",
        "debug"
      ]
    },
    "difficulty": {
      "type": "string",
      "minLength": 1
    },
    "estimated_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "competencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "brief": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "macro_steps": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/step"
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "runner"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "runner": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "test_pattern": {
            "type": "string"
          },
          "timeout": {
            "type": "string"
          },
          "network": {
            "type": "boolean",
            "description": "Defaults to false (denied); safe-check-executor requirement R5."
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Reserved: never exposed by the catalog's default public queries."
    },
    "fixture": {
      "type": "array",
      "description": "Starter files this challenge ships (e.g. buggy code for a debug challenge); administrative-cli-fixtures requirement R6.",
      "items": {
        "type": "object",
        "required": [
          "path",
          "content"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Relative, never absolute or containing '..'.",
            "not": {
              "pattern": "(^|/)\\.\\.(/|$)|^/|^[A-Za-z]:|\\\\"
            }
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "publication": {
      "type": "object",
      "description": "Editorial metadata gating status: published (catalog-authoring-quality requirement R7).",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "",
            "draft",
            "published"
          ]
        },
        "author": {
          "type": "string"
        },
        "reviewed_by": {
          "type": "string",
          "description": "Must differ from author when status is published."
        },
        "playtested": {
          "type": "boolean"
        }
      },
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "published"
          }
        }
      },
      "then": {
        "required": [
          "author",
          "reviewed_by",
          "playtested"
        ],
        "properties": {
          "author": {
            "pattern": "\\S"
          },
          "reviewed_by": {
            "pattern": "\\S"
          },
          "playtested": {
            "const": true
          }
        }
      }
    },
    "canonical": {
      "type": "boolean"
    },
    "variant_of": {
      "type": "string",
      "minLength": 1
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_fixture",
        "expectations"
      ],
      "properties": {
        "baseline_fixture": {
          "type": "array",
          "description": "Starter files this challenge ships (e.g. buggy code for a debug challenge); administrative-cli-fixtures requirement R6.",
          "items": {
            "type": "object",
            "required": [
              "path",
              "content"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Relative, never absolute or containing '..'.",
                "not": {
                  "pattern": "(^|/)\\.\\.(/|$)|^/|^[A-Za-z]:|\\\\"
                }
              },
              "content": {
                "type": "string"
              }
            }
          }
        },
        "justification": {
          "type": "string"
        },
        "reference_fixture": {
          "type": "array",
          "description": "Starter files this challenge ships (e.g. buggy code for a debug challenge); administrative-cli-fixtures requirement R6.",
          "items": {
            "type": "object",
            "required": [
              "path",
              "content"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Relative, never absolute or containing '..'.",
                "not": {
                  "pattern": "(^|/)\\.\\.(/|$)|^/|^[A-Za-z]:|\\\\"
                }
              },
              "content": {
                "type": "string"
              }
            }
          },
          "minItems": 1
        },
        "expectations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "baseline",
              "reference"
            ],
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1
              },
              "baseline": {
                "enum": [
                  "pass",
                  "test_failure",
                  "compile_failure",
                  "format_failure",
                  "analysis_failure",
                  "syntax_failure"
                ]
              },
              "reference": {
                "const": "pass"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "description": "A macro, meso or micro step (PROJECT.md \u00a714.9). Recursive via children.",
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "macro",
            "meso",
            "micro"
          ]
        },
        "action": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "instruction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "objective": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            },
            "constraints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              }
            }
          }
        },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requires_positive_evaluation": {
              "type": "boolean"
            },
            "requires_user_confirmation": {
              "type": "boolean"
            }
          }
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "level",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "level": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "kind": {
                "type": "string"
              }
            }
          }
        },
        "reflection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "optional": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/step"
          }
        },
        "children_mode": {
          "type": "string",
          "enum": [
            "sequence",
            "choice"
          ]
        }
      }
    }
  }
}
